{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:web", "type:app"],
  "implicitDependencies": ["contracts"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev -w @cinehub/web"
      },
      "configurations": {
        "portal": {
          "command": "npm run dev:portal -w @cinehub/web"
        }
      }
    },
    "serve-portal": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev:portal -w @cinehub/web"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build -w @cinehub/web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/web"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test -w @cinehub/web"
      }
    }
  }
}
