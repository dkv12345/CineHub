{
  "name": "aggregator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/aggregator/src",
  "projectType": "application",
  "tags": ["scope:server", "type:app"],
  "implicitDependencies": ["db", "contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check apps/aggregator/src/jobs/crawl-galaxy.js"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/aggregator"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test -w @cinehub/aggregator"
      }
    }
  }
}
