# ----- Docker Compose (tạo container) -----
MYSQL_ROOT_PASSWORD=cinehub_root
MYSQL_DATABASE=cinehub
MONGO_INITDB_ROOT_USERNAME=cinehub
MONGO_INITDB_ROOT_PASSWORD=cinehub_pw

# ----- Ứng dụng Backend -----
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:cinehub_root@localhost:3306/cinehub
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://cinehub:cinehub_pw@localhost:27017/cinehub?authSource=admin
JWT_ACCESS_SECRET=your-jwt-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars
QR_HMAC_SECRET=your-qr-hmac-secret-at-least-32-chars
CLIENT_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

# ----- Email SMTP (Cấu hình gửi mã OTP) -----
# Lựa chọn 1: Gmail thật (Dùng Mật khẩu ứng dụng Google 16 ký tự)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="CineHub <your-email@gmail.com>"

# Lựa chọn 2: Mailtrap Sandbox (Hộp thư ảo kiểm thử)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-password
# SMTP_FROM="CineHub <no-reply@cinehub.vn>"

# ----- Google OAuth (tuỳ chọn) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/auth
VITE_GOOGLE_CLIENT_ID=

# ----- Crawler (Galaxy Cinema) -----
GALAXY_BASE_URL=https://www.galaxycine.vn
GALAXY_REQUEST_DELAY_MS=1000
CRAWL_DAYS_AHEAD=7

# ----- Frontend (Vite & Angular) -----
VITE_API_URL=http://localhost:4000

# ----- CineBot Gemini (tuỳ chọn; model do bạn cấu hình) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
GEMINI_TIMEOUT_MS=20000
MONGODB_DB=cinehub
