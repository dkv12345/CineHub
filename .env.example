# ----- Docker Compose (tạo container) -----
MYSQL_ROOT_PASSWORD=cinehub_root
MYSQL_DATABASE=cinehub
MONGO_INITDB_ROOT_USERNAME=cinehub
MONGO_INITDB_ROOT_PASSWORD=cinehub_pw

# ----- Ứng dụng Backend -----
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://root:cinehub_root@localhost:3306/cinehub
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://cinehub:cinehub_pw@localhost:27017/cinehub?authSource=admin
JWT_ACCESS_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-khac-access-32
JWT_REFRESH_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-khac-refresh-32
QR_HMAC_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-qr-hmac-32
CLIENT_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# ----- Mailtrap SMTP (Hạ tầng gửi Email Sandbox) -----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CineHub <no-reply@cinehub.vn>"

# ----- Google OAuth (tuỳ chọn) -----
# Lưu ý: Trong Google Cloud Console, mục "Authorized JavaScript origins" BẮT BUỘC phải thêm `http://localhost:4200`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/auth

# ----- CineBot Gemini (tuỳ chọn; model do bạn cấu hình) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
GEMINI_TIMEOUT_MS=20000
SHOWTIMES_CACHE_TTL_SECONDS=300
SHOWTIMES_UPSTREAM_RETRY_SECONDS=30
MONGODB_DB=cinehub

# ----- Crawler (Galaxy Cinema) -----
GALAXY_BASE_URL=https://www.galaxycine.vn
GALAXY_REQUEST_DELAY_MS=1000
CRAWL_DAYS_AHEAD=7
