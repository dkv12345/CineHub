{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db/src",
  "projectType": "library",
  "tags": ["scope:server", "type:data-access"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx prisma generate --schema=libs/db/prisma/schema.prisma"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint libs/db"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test -w @cinehub/db"
      }
    }
  }
}
