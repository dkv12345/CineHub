{
  "name": "testing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/testing/src",
  "tags": ["scope:web", "type:util"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint libs/web/testing"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run libs/web/testing/test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.log('testing validated')\""
      }
    }
  }
}
