{
  "name": "catalog-ui",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/catalog/ui/src",
  "tags": ["scope:web", "type:ui"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint libs/web/catalog/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run libs/web/catalog/ui/test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.log('catalog-ui validated')\""
      }
    }
  }
}
