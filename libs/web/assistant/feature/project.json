{
  "name": "assistant-feature",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/assistant/feature/src",
  "tags": ["scope:web", "type:feature"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint libs/web/assistant/feature"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run libs/web/assistant/feature/test"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.log('assistant-feature validated')\""
      }
    }
  }
}
