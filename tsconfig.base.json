{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@cinehub/contracts": ["libs/shared/contracts/src/index.js"],
      "@cinehub/web/shared/data-access": ["libs/web/shared/data-access/src/index.ts"],
      "@cinehub/web/shared/util": ["libs/web/shared/util/src/index.ts"],
      "@cinehub/web/shared/ui": ["libs/web/shared/ui/src/index.ts"],
      "@cinehub/web/testing": ["libs/web/testing/src/index.ts"],
      "@cinehub/web/core": ["libs/web/core/src/index.ts"],
      "@cinehub/web/shell": ["libs/web/shell/src/index.ts"],
      "@cinehub/web/auth/data-access": ["libs/web/auth/data-access/src/index.ts"],
      "@cinehub/web/auth/feature": ["libs/web/auth/feature/src/index.ts"],
      "@cinehub/web/catalog/data-access": ["libs/web/catalog/data-access/src/index.ts"],
      "@cinehub/web/catalog/ui": ["libs/web/catalog/ui/src/index.ts"],
      "@cinehub/web/catalog/feature": ["libs/web/catalog/feature/src/index.ts"],
      "@cinehub/web/showtimes/util": ["libs/web/showtimes/util/src/index.ts"],
      "@cinehub/web/showtimes/data-access": ["libs/web/showtimes/data-access/src/index.ts"],
      "@cinehub/web/showtimes/ui": ["libs/web/showtimes/ui/src/index.ts"],
      "@cinehub/web/showtimes/feature": ["libs/web/showtimes/feature/src/index.ts"],
      "@cinehub/web/concessions/data-access": ["libs/web/concessions/data-access/src/index.ts"],
      "@cinehub/web/concessions/feature": ["libs/web/concessions/feature/src/index.ts"],
      "@cinehub/web/seat-3d": ["libs/web/seat-3d/src/index.ts"],
      "@cinehub/web/booking/data-access": ["libs/web/booking/data-access/src/index.ts"],
      "@cinehub/web/booking/ui": ["libs/web/booking/ui/src/index.ts"],
      "@cinehub/web/booking/feature": ["libs/web/booking/feature/src/index.ts"],
      "@cinehub/web/tickets/data-access": ["libs/web/tickets/data-access/src/index.ts"],
      "@cinehub/web/tickets/feature": ["libs/web/tickets/feature/src/index.ts"],
      "@cinehub/web/account/data-access": ["libs/web/account/data-access/src/index.ts"],
      "@cinehub/web/account/feature": ["libs/web/account/feature/src/index.ts"],
      "@cinehub/web/assistant/data-access": ["libs/web/assistant/data-access/src/index.ts"],
      "@cinehub/web/assistant/feature": ["libs/web/assistant/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
