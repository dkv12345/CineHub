# syntax=docker/dockerfile:1
FROM node:20-alpine AS deps
WORKDIR /workspace
COPY package.json package-lock.json nx.json tsconfig.base.json ./
COPY apps/core-api/package.json ./apps/core-api/
COPY libs/db/package.json ./libs/db/
COPY libs/db/prisma ./libs/db/prisma
COPY libs/shared/contracts/package.json ./libs/shared/contracts/
RUN npm ci --workspace=@cinehub/core-api --workspace=@cinehub/db --workspace=@cinehub/contracts --include-workspace-root

FROM node:20-alpine AS runner
WORKDIR /workspace
ENV NODE_ENV=production
ENV PORT=4000
COPY --from=deps /workspace/node_modules ./node_modules
COPY package.json ./
COPY libs/db ./libs/db
COPY libs/shared/contracts ./libs/shared/contracts
COPY apps/core-api ./apps/core-api
EXPOSE 4000
CMD ["node", "apps/core-api/src/bootstrap/server.js"]
