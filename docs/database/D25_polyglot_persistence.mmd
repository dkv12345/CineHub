flowchart TB
    %% =========================================================================
    %% TIER 1: CLIENT PRESENTATION TIER
    %% =========================================================================
    subgraph ClientTier ["1. Client Presentation Tier (Angular 19 Hybrid)"]
        Browser["Desktop & Mobile Browsers\n(Hydrated Angular CSR)"]
        SSR["Angular SSR Server Engine\n(Node.js Pre-rendering for Catalog)"]
    end

    %% =========================================================================
    %% TIER 2: BACKEND APPLICATION TIER
    %% =========================================================================
    subgraph AppTier ["2. Application Tier (apps/core-api & apps/aggregator)"]
        API["Core API Gateway & Controllers\n(Node.js / Express REST API)"]
        Crawler["Galaxy Cinema Sync Aggregator\n(Scheduled Web Scraper)"]
        Worker["Background Sweeper & Relay Worker\n(Outbox Dispatcher & TTL Cleanup)"]
        CineBot["CineBot AI Assistant Service\n(Gemini 2.5 Flash SDK Integration)"]
    end

    %% =========================================================================
    %% TIER 3: POLYGLOT PERSISTENCE TIER
    %% =========================================================================
    subgraph StorageTier ["3. Polyglot Persistence Tier (Storage Allocation)"]
        
        %% MySQL Subgraph
        subgraph MySQL_Zone ["MySQL 8.0 (ACID Relational Core - Single Source of Truth)"]
            M_Auth[("Identity & Security\n• users, refresh_tokens\n• password_reset_tokens")]
            M_Catalog[("Catalog & Scheduling\n• movies, showtimes, seats\n• showtime_seats, prices")]
            M_Orders[("Commerce & State\n• bookings, booking_seats\n• payments, tickets (QR HMAC)")]
            M_Outbox[("Platform Reliability\n• outbox_events\n• inbox_events (Idempotency)")]
        end

        %% Redis Subgraph
        subgraph Redis_Zone ["Redis 7.0 In-Memory Engine (Speed & Concurrency)"]
            R_Lease["seat:lease:showtimeId:seatId\n(Distributed Lease Lock - TTL 15m)"]
            R_Set["hold:set:showtimeId\n(Active Reserved Seat Set)"]
            R_Limit["ratelimit:ip:endpoint\n(Sliding Window Throttling)"]
            R_Cache["catalog:movies:now-showing\n(Read-aside Cache - TTL 5m)"]
        end

        %% MongoDB Subgraph
        subgraph Mongo_Zone ["MongoDB Atlas (Unstructured Data & AI Engine)"]
            MG_Raw["crawl_raw_items & crawl_runs\n(Raw Galaxy API JSON Responses)"]
            MG_Vec["movie_embeddings\n(768-dim Vector Search Index)"]
            MG_Chat["chat_sessions\n(CineBot Memory Buffers)"]
        end
    end

    %% =========================================================================
    %% DATA FLOWS & INTERACTIONS
    %% =========================================================================
    Browser -->|HTTP REST API v1| API
    Browser -->|Direct Web Request| SSR
    SSR -->|Fetch Catalog Data| API

    %% Aggregator Flows
    Crawler -->|1. Store Raw JSON Dumps| MG_Raw
    Crawler -->|2. Upsert Sanitized Catalog Records| M_Catalog

    %% Core API Operations
    API -->|1. Atomic Lua Script: SET NX lease| R_Lease
    API -->|2. ACID Transaction: FOR UPDATE & activeLock| M_Orders
    API -->|3. Commit OutboxEvent in Same Tx| M_Outbox
    API -->|Read-aside Cache Queries| R_Cache

    %% Background Worker Flows
    Worker -->|Poll Pending Events with SKIP LOCKED| M_Outbox
    Worker -->|Sweep Expired Bookings & Reset Locks| M_Orders
    Worker -->|Evict Stale In-Memory Leases| R_Lease

    %% AI CineBot Flows
    CineBot -->|kNN Cosine Vector Search| MG_Vec
    CineBot -->|Query Live Showtime Availability| M_Catalog

    %% =========================================================================
    %% STYLING & CLASSES
    %% =========================================================================
    classDef client fill:#f8fafc,stroke:#64748b,stroke-width:1.5px,color:#0f172a;
    classDef app fill:#f1f5f9,stroke:#475569,stroke-width:1.5px,color:#0f172a;
    classDef mysql fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#1e3a8a;
    classDef redis fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#991b1b;
    classDef mongo fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#166534;

    class Browser,SSR client;
    class API,Crawler,Worker,CineBot app;
    class M_Auth,M_Catalog,M_Orders,M_Outbox mysql;
    class R_Lease,R_Set,R_Limit,R_Cache redis;
    class MG_Raw,MG_Vec,MG_Chat mongo;

