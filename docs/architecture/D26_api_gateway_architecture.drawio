        <mxCell id="edge_auth_zod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;" edge="1" parent="box_gateway" source="mw_auth" target="mw_zod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: DOMAIN MODULES -->
        <mxCell id="box_domain" value="Domain Modules (/src/modules/*)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1e40af;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="90" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="mod_ctrl" value="&lt;b&gt;Module Controller&lt;/b&gt;&lt;br&gt;(Extract DTO &amp;amp; Context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="box_domain">
