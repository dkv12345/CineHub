        <mxCell id="edge_gateway_ctrl" value="Validated DTO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontColor=#1e40af;" edge="1" parent="1" source="mw_zod" target="mod_ctrl">
          <mxGeometry relative="1" as="geometry">
