        <mxCell id="edge_svc_success" value="Success Result&lt;br&gt;(200 / 201)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2;fontSize=11;fontColor=#166534;" edge="1" parent="1" source="mod_svc" target="env_success">
