        </mxCell>

        <mxCell id="mod_svc" value="&lt;b&gt;Domain Service&lt;/b&gt;&lt;br&gt;(Business Logic, Lua Lock,&lt;br&gt;Prisma Transaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="box_domain">
