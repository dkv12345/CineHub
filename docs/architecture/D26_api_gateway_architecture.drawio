        <mxCell id="edge_ctrl_svc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=1.5;" edge="1" parent="box_domain" source="mod_ctrl" target="mod_svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: RESPONSE ENVELOPES -->
        <mxCell id="box_envelope" value="Response Standardization" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#0f172a;startSize=30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="90" width="290" height="490" as="geometry" />
        </mxCell>

        <mxCell id="env_success" value="&lt;b&gt;Standard Success Envelope&lt;/b&gt;&lt;br&gt;(HTTP 200 / 201 Created)&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-family:monospace;font-size:10px;&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;success&quot;: true,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;data&quot;: { ... },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;meta&quot;: { &quot;timestamp&quot;, &quot;requestId&quot; }&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontSize=11;fontColor=#166534;" vertex="1" parent="box_envelope">
          <mxGeometry x="20" y="45" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="env_error" value="&lt;b&gt;Standard Error Envelope&lt;/b&gt;&lt;br&gt;(HTTP 400, 401, 403, 409, 500)&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-family:monospace;font-size:10px;&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;success&quot;: false,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;error&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;code&quot;: &quot;SEAT_CONFLICT&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;message&quot;: &quot;Seat already held&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;details&quot;: { ... }&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;meta&quot;: { &quot;timestamp&quot;, &quot;requestId&quot; }&lt;br&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.5;fontSize=11;fontColor=#991b1b;" vertex="1" parent="box_envelope">
          <mxGeometry x="20" y="225" width="250" height="210" as="geometry" />
        </mxCell>

        <!-- MAIN FLOW ARROWS -->
        <mxCell id="edge_client_gateway" value="HTTP Request&lt;br&gt;+ JWT Header" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f172a;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="client" target="mw_cors">
