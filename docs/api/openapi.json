{
  "openapi": "3.1.0",
  "info": {
    "title": "CineHub Core API",
    "version": "1.0.0",
    "description": "Enterprise Cinema Ticketing Platform REST API (Contract-First from @cinehub/contracts Zod schemas)."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local Core API"
    },
    {
      "url": "http://localhost:4200",
      "description": "Angular Dev Server Proxy"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "avatarUrl": {
            "type": ["string", "null"]
          },
          "role": {
            "type": "string",
            "enum": ["CUSTOMER", "STAFF", "ADMIN"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "LOCKED", "DELETED"]
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": ["id", "email", "fullName", "role", "status"]
      },
      "AuthSessionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string"
              },
              "refreshToken": {
                "type": "string"
              },
              "user": {
                "$ref": "#/components/schemas/UserDto"
              }
            },
            "required": ["accessToken", "user"]
          }
        },
        "required": ["data"]
      },
      "CinemaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "phone": {
            "type": ["string", "null"]
          },
          "latitude": {
            "type": ["number", "null"]
          },
          "longitude": {
            "type": ["number", "null"]
          }
        },
        "required": ["id", "name", "chain", "address"]
      },
      "MovieDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "originalTitle": {
            "type": ["string", "null"]
          },
          "slug": {
            "type": "string"
          },
          "synopsis": {
            "type": ["string", "null"]
          },
          "durationMinutes": {
            "type": "integer"
          },
          "releaseDate": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["COMING_SOON", "NOW_SHOWING", "ENDED"]
          },
          "ageRating": {
            "type": "string",
            "enum": ["P", "K", "T13", "T16", "T18", "C"]
          },
          "posterUrl": {
            "type": ["string", "null"]
          },
          "backdropUrl": {
            "type": ["string", "null"]
          },
          "trailerUrl": {
            "type": ["string", "null"]
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "rating": {
            "type": ["number", "null"]
          }
        },
        "required": ["id", "title", "durationMinutes", "status", "ageRating"]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "movieId": {
            "type": "string"
          },
          "cinemaId": {
            "type": "string"
          },
          "hallId": {
            "type": "string"
          },
          "hallName": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "captionMode": {
            "type": "string"
          },
          "basePrice": {
            "type": "number"
          }
        },
        "required": ["id", "movieId", "cinemaId", "startTime", "format", "basePrice"]
      },
      "ConcessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "category": {
            "type": "string",
            "enum": ["COMBO", "POPCORN", "DRINK", "SNACK"]
          },
          "price": {
            "type": "number"
          },
          "imageUrl": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "name", "category", "price"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "phone": {
            "type": "string"
          }
        },
        "required": ["fullName", "email", "password"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": ["email", "code"]
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["email"]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "GoogleAuthRequest": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["idToken"]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100
          }
        },
        "required": ["token", "newPassword"]
      },
      "LockSeatsRequest": {
        "type": "object",
        "properties": {
          "showtimeId": {
            "type": "string",
            "minLength": 1
          },
          "seatIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 6
          }
        },
        "required": ["showtimeId", "seatIds"]
      },
      "UpdateConcessionsRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "concessionId": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "required": ["concessionId", "quantity"]
            }
          }
        },
        "required": ["items"]
      },
      "ApplyVoucherRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["code"]
      },
      "ChatMessageRequest": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["message"]
      },
      "RecommendationsRequest": {
        "type": "object",
        "properties": {
          "recentMovieIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36
            },
            "maxItems": 20,
            "default": []
          },
          "favoriteMovieIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36
            },
            "maxItems": 20,
            "default": []
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Health"],
        "summary": "Check API and database liveness",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "db": {
                      "type": "string"
                    }
                  },
                  "required": ["status", "db"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerUser",
        "tags": ["Auth"],
        "summary": "Register a new customer account",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "phone": {
                    "type": "string"
                  }
                },
                "required": ["fullName", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration created; verification OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/UserDto"
                        }
                      },
                      "required": ["user"]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "verifyEmail",
        "tags": ["Auth"],
        "summary": "Verify customer email with 6-digit OTP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": ["email", "code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified and session issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "operationId": "resendVerification",
        "tags": ["Auth"],
        "summary": "Resend 6-digit verification OTP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginUser",
        "tags": ["Auth"],
        "summary": "Authenticate with email and password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google": {
      "post": {
        "operationId": "loginWithGoogle",
        "tags": ["Auth"],
        "summary": "Authenticate with Google ID token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["idToken"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated via Google",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh-token": {
      "put": {
        "operationId": "refreshAccessToken",
        "tags": ["Auth"],
        "summary": "Rotate refresh token and issue a new access token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "delete": {
        "operationId": "logoutUser",
        "tags": ["Auth"],
        "summary": "Clear session and revoke refresh token cookie",
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "forgotPassword",
        "tags": ["Auth"],
        "summary": "Request password reset link via email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset email dispatched if account exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "tags": ["Auth"],
        "summary": "Complete password reset using token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 100
                  }
                },
                "required": ["token", "newPassword"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["Auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get currently authenticated user profile",
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "$ref": "#/components/schemas/UserDto"
                        }
                      },
                      "required": ["user"]
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cinemas": {
      "get": {
        "operationId": "listCinemas",
        "tags": ["Cinemas"],
        "summary": "List cinemas with optional chain and province filters",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "required": false,
            "name": "page",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer"
            },
            "required": false,
            "name": "pageSize",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "chain",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "province",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cinema list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CinemaDto"
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies": {
      "get": {
        "operationId": "listMovies",
        "tags": ["Movies"],
        "summary": "List movies in catalog",
        "responses": {
          "200": {
            "description": "Movie list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MovieDto"
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/movies/{id}": {
      "get": {
        "operationId": "getMovieById",
        "tags": ["Movies"],
        "summary": "Get movie details by ID",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Movie details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MovieDto"
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "listSessions",
        "tags": ["Sessions"],
        "summary": "List showtime sessions by movie, cinema, or date",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "movieId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cinemaId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Session list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SessionDto"
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/concessions": {
      "get": {
        "operationId": "listConcessions",
        "tags": ["Concessions"],
        "summary": "List F&B concessions by chain and cinema code",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "chain",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cinemaCode",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Concession list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
